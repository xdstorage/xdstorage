<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <!-- Task 2.2.0/43 VERIFYAPI owns the real fix (the structured verify()
         report; the tool-vs-library print decision for Compact). Until it
         lands, the existing stderr sites are exempt from the PRINT BANS only —
         every other check applies to these files in full. -->
    <suppress checks="RegexpSingleline" files="[\\/]XdStorageFolderVerifier\.java$"/>
    <suppress checks="RegexpSingleline" files="[\\/]Compact\.java$"/>
    <!-- FP-3 (2.2.0/08): the build-time wrapper generation is a TOOL like
         Compact — its stdout line is the build tool's feedback, its exit
         status is the build's. PRINT BANS only; the generator it drives
         (XdStorageAotWrapperGenerator) logs through slf4j. The tool-vs-library
         print decision stays with task 43. -->
    <suppress checks="RegexpSingleline" files="[\\/]GenerateWrappers\.java$"/>
    <!-- The print bans protect the SHIPPED library only: test diagnostics
         (System.out in the suites) are the test corpus's own reporting style,
         not part of the artifact. -->
    <suppress checks="RegexpSingleline" files="[\\/]src[\\/]main[\\/]test[\\/].*"/>
</suppressions>
