<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.xdstorage</groupId>
    <artifactId>xdstorage</artifactId>
    <packaging>jar</packaging>
    <!-- E-1: semver — the single source of truth. It reaches the jar as the Maven-filtered
         /xdstorage.properties resource (XdStorage.getVersion()). Bumped at TRAIN START
         (docs/RELEASE-PLAN.md §2 step 3): the pom carries the version of the release the
         train is heading toward; the tag at the end matches it (version-sanity check). -->
    <version>2.1.0</version>

    <name>XdStorage</name>
    <description>Embedded Java object storage: ACID transactions with MVCC snapshots over human-readable
        YAML/XML files, B+tree and hash indexes, a criteria search engine, triggers, and pluggable
        serialization. Zero native dependencies; Java 8 bytecode.</description>
    <url>https://github.com/xdstorage/xdstorage</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/xdstorage/xdstorage</url>
        <connection>scm:git:https://github.com/xdstorage/xdstorage.git</connection>
        <developerConnection>scm:git:git@github.com:xdstorage/xdstorage.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <!-- Mandatory for Maven Central (the first 2.0.0 deployments were rejected:
         "Developers information is missing"). Identity = the project author. -->
    <developers>
        <developer>
            <id>ewgeny</id>
            <name>Evgeny Korolev</name>
            <email>e-korolev@rambler.ru</email>
            <roles>
                <role>architect</role>
                <role>developer</role>
                <role>maintainer</role>
            </roles>
        </developer>
    </developers>

    <properties>
        <!-- H-5: library bytecode stays 1.8-compatible; dev/test runtime is JDK 17. -->
        <jdk.version>8</jdk.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- E-2: reproducible builds — fixed timestamp baked into jar entries. Bump it in the
             release checklist (docs/RELEASE-PLAN.md §2) so every release is byte-distinct. -->
        <project.build.outputTimestamp>2026-10-21T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.8.1</version>
        </dependency>

        <!-- L-0/L-1 (docs/tasks/2.1.0/01): the ONLY logging artifact in main scope — the
             library logs through the SLF4J API and ships no backend; the backend and its
             configuration are the consumer's choice (docs/examples/logging/). -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.20</version>
        </dependency>

        <!-- T-2 vintage cleanup (docs/tasks/2.1.0/05): JUnit 4 removed — the last three
             vintage classes were migrated to JUnit 5 (they had been silently dead: the
             JUnit Platform provider needs the vintage engine to run JUnit 4 classes, and
             none was ever configured). Tag semantics are now uniform across the estate. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>4.2.0</version>
            <scope>test</scope>
        </dependency>

        <!-- L-1: log4j2 is the TEST-scope SLF4J backend (versions must match). The suite's
             config lives at src/main/test/resources/log4j2.xml; test sources may also use
             the log4j2 API directly. The published jar carries neither — L-3's enforcer
             rule keeps backends out of compile/runtime scope permanently. -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.23.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <version>2.23.1</version>
            <scope>test</scope>
        </dependency>

        <!-- stress tests -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>1.37</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>1.37</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>src/main/test/resources</directory>
            </testResource>
        </testResources>

        <testSourceDirectory>src/main/test</testSourceDirectory>

        <resources>
            <!-- A2: the version resource is the only filtered file; everything else is copied verbatim. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>xdstorage.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>xdstorage.properties</exclude>
                </excludes>
            </resource>
        </resources>

        <pluginManagement>
            <plugins>
                <!-- E-2: pinned so jar entries honor project.build.outputTimestamp (reproducible builds). -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- H-5: library bytecode stays 1.8-compatible; dev/test runtime is JDK 17.
                         release=8 also pins the platform API so post-8 API use fails the build. -->
                    <release>${jdk.version}</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0-M4</version>
                <configuration>
                    <forkCount>1</forkCount>
                    <!-- R-42: 1g не хватает на весь суит в одном форке: ~71 класс стресс-тестов,
                         codegen-обертки и канонические реестры накапливаются до OOM на giant-purge.
                         2g покрывает кумулятивный след полного прогона.
                         @{argLine} — late evaluation so the JaCoCo agent (T-1) is prepended;
                         without it the literal argLine would silently drop the -javaagent switch. -->
                    <argLine>@{argLine} -Xmx2g -Xlog:gc:file=/tmp/gc-fork.log:time,uptime,level,tags:filecount=2,filesize=50m</argLine>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <!-- GATE policy (docs decision 2c43b8c, 2026-11-08): the two saturated-storm
                         families are excluded from the gate/default run — their reds are the
                         THROUGHPUT ENVELOPE (the per-record YAML floor vs 25×400 and the
                         8×100 ms budgets), not correctness (task 47 fixed the correctness
                         families: Illegal state = 0 estate-wide). The correctness coverage for
                         both families lives in the invariant/protocol tests; the envelope runs
                         belong to the nightly (the -Dtest exclusions) and the perf gate
                         (2.2.0 task 10). BTreeTargetedDeleteStress stays IN: its stale-descent
                         family is fixed (task 47) and it is green. -->
                    <excludes>
                        <exclude>**/XdStorageFacadeStressTest.java</exclude>
                        <exclude>**/XdStorageMassFillAndCleanFirstStressTest.java</exclude>
                        <exclude>**/XdStorageMassFillAndCleanSecondStressTest.java</exclude>
                        <exclude>**/XdStorageNestedTransactionIsolationStressTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- T-1 (docs/tasks/2.1.0/04): JaCoCo coverage baseline — MEASURE AND PUBLISH ONLY.
                 prepare-agent + report, deliberately NO check goal and no thresholds: coverage
                 numbers must never be able to fail the build (honest-metrics culture,
                 MASTER-PLAN § Track T-1). The report lands at target/site/jacoco/ in verify;
                 CI uploads it as the jacoco-report artifact. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- E-2: build-environment floor for every build, not just releases — an JDK 8 build
                 or an ancient Maven must fail loudly instead of producing a second-class jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[17,)</version>
                                    <message>XdStorage builds on JDK 17+ (bytecode target stays 8, H-5)</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.6.3,)</version>
                                </requireMavenVersion>
                                <!-- L-3 (docs/tasks/2.1.0/03): logging BACKENDS and SLF4J bindings
                                     are banned from compile/runtime scope forever — the jar must ship
                                     the SLF4J API only; the backend is the consumer's choice. Test
                                     scope stays legal (the suite binds log4j2 on purpose). Pattern
                                     format per the enforcer docs: group:artifact:version:type:SCOPE:
                                     classifier — the scope is the 5th component (a trailing 6th-part
                                     scope silently matches nothing). slf4j-api in compile scope is
                                     deliberately NOT on the list: the rule bans backends, not the API. -->
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.apache.logging.log4j:*:*:*:compile</exclude>
                                        <exclude>org.apache.logging.log4j:*:*:*:runtime</exclude>
                                        <exclude>ch.qos.logback:logback-classic:*:*:compile</exclude>
                                        <exclude>ch.qos.logback:logback-classic:*:*:runtime</exclude>
                                        <exclude>org.slf4j:slf4j-simple:*:*:compile</exclude>
                                        <exclude>org.slf4j:slf4j-simple:*:*:runtime</exclude>
                                        <exclude>org.slf4j:slf4j-jdk14:*:*:compile</exclude>
                                        <exclude>org.slf4j:slf4j-jdk14:*:*:runtime</exclude>
                                        <exclude>org.slf4j:slf4j-nop:*:*:compile</exclude>
                                        <exclude>org.slf4j:slf4j-nop:*:*:runtime</exclude>
                                        <exclude>org.slf4j:slf4j-reload4j:*:*:compile</exclude>
                                        <exclude>org.slf4j:slf4j-reload4j:*:*:runtime</exclude>
                                        <exclude>org.slf4j:slf4j-log4j12:*:*:compile</exclude>
                                        <exclude>org.slf4j:slf4j-log4j12:*:*:runtime</exclude>
                                    </excludes>
                                    <message>L-3: a logging backend or an SLF4J binding entered compile/runtime
                                        scope — the jar must ship org.slf4j:slf4j-api ONLY. Backends are the
                                        consumer's choice (docs/examples/logging/); rationale:
                                        docs/tasks/2.1.0/03-logging-build-guards.md, docs/MASTER-PLAN.md § Track L-3.
                                        Test-scope backends stay legal.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- C-2: быстрый гейт без известных флаки-семей (docs/FLAKY.md).
             Полный суит (включая флаки) остается умолчанием: mvn clean test.
             Включение: mvn clean test -Pquick-gate
             T-2 (docs/tasks/2.1.0/05): this profile deliberately does NOT switch to
             <excludedGroups>stress,integration — its contract is "documented flaky families
             only" (the 4-name list below), which the two structural tags cannot express:
             tagging everything stress would pull 16 non-flaky stress classes out of the dev
             loop. The release profile is tag-driven since 2.1.0; reconsider this profile's
             mechanism together with the 3.0 backstop removal (a dedicated flaky tag would
             be the way). -->
        <profile>
            <id>quick-gate</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.0.0-M4</version>
                        <configuration>
                            <forkCount>1</forkCount>
                            <argLine>@{argLine} -Xmx2g -Xlog:gc:file=/tmp/gc-fork.log:time,uptime,level,tags:filecount=2,filesize=50m</argLine>
                            <includes>
                                <include>**/*Test.java</include>
                            </includes>
                            <excludes>
                                <!-- docs/FLAKY.md: документированные редкие флаки под пиковой нагрузкой.
                                     2026-10-26 (решение архитектора): список ВКЛЮЧЕН снова + пополнен —
                                     вложенные транзакции не рекомендованы к использованию (критичны под
                                     нагрузкой, docs/tasks/2.2.0/12), нагрузочный тест фасада уходит в 2.2.0
                                     на исследование (docs/tasks/2.2.0/13). Остальные четыре — исторические
                                     семейства из docs/FLAKY.md. -->
                                <exclude>**/XdStorageFacadeStressTest.java</exclude>
                                <exclude>**/XdStorageMassFillAndCleanFirstStressTest.java</exclude>
                                <exclude>**/XdStorageMassFillAndCleanSecondStressTest.java</exclude>
                                <exclude>**/XdStorageNestedTransactionIsolationStressTest.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- E-2/E-3: the release profile — source/javadoc jars, signing, release-only enforcer
             rules, publish to Maven Central via the Central Portal (publishingServerId "central"),
             and a NON-STRESS test suite: the stress families (docs/FLAKY.md) run in the nightly
             and the RC protocol (docs/RELEASE-PLAN.md §2), not in the tag pipeline.
             Activated by the tag-triggered release workflow (.github/workflows/release.yml);
             requires CI secrets — see docs/RELEASE-PLAN.md §1. Local dry run without a GPG key:
             mvn -Prelease -Dgpg.skip=true verify  (builds binary + sources + javadoc jars). -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.0.0-M4</version>
                        <configuration>
                            <forkCount>1</forkCount>
                            <argLine>@{argLine} -Xmx2g -Xlog:gc:file=/tmp/gc-fork.log:time,uptime,level,tags:filecount=2,filesize=50m</argLine>
                            <includes>
                                <include>**/*Test.java</include>
                            </includes>
                            <!-- T-2 (docs/tasks/2.1.0/05): the tag-driven exclusion is now the
                                 primary mechanism — every *StressTest class and every integration
                                 class carries @Tag("stress") / @Tag("integration") (the pairing
                                 contract is enforced by XdStorageTestGroupingContractTest in the
                                 default run). The filename patterns below stay as the 2.1.0
                                 backstop; their removal is scheduled for 3.0. -->
                            <excludedGroups>stress,integration</excludedGroups>
                            <excludes>
                                <!-- Release builds run the correctness suite only: every
                                     *StressTest family, the Xml multithread stress, and the
                                     integration package — the slow and load-sensitive part of
                                     the run. They stay mandatory in the nightly and the
                                     RC protocol (docs/RELEASE-PLAN.md § Quality bar).
                                <exclude>**/*StressTest.java</exclude>
                                <exclude>**/XmlDataStorageMultithreadsTest.java</exclude>
                                <exclude>**/integration/**</exclude-->
                            </excludes>
                        </configuration>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <!-- JAVADOC (docs/tasks/2.1.0/28): the deferred 2.0.0 promise is
                                 closed — the whole main tree is javadoc'd (the coverage gate is
                                 `mvn javadoc:javadoc -Ddoclint=missing` green) and the release
                                 build now enforces it: doclint missing+syntax with
                                 failOnWarnings, so the published javadoc jar can never silently
                                 regress. failOnError stays default-true: a doc error fails the
                                 release like any other build error. -->
                            <doclint>missing,syntax</doclint>
                            <failOnWarnings>true</failOnWarnings>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- E-3: Maven Central requires signed artifacts. The key arrives via CI
                         secrets (GPG_PRIVATE_KEY/GPG_PASSPHRASE); locally export your key to test. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </plugin>

                    <!-- E-3: publish to Maven Central via the Central Portal. Requires the
                         namespace io.github.xdstorage to be verified and a user token stored as
                         CI secrets (server id "central") — docs/RELEASE-PLAN.md §1.
                         0.12.0 MINIMUM: older versions did not strip Maven 3.10's
                         maven-metadata-local.xml / _remote.repositories from the staging repo,
                         and Central rejects the bundle with "Bundle has content that does NOT
                         have a .pom file" (the 2.0.0 first-release pipeline hit exactly this). -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>3.4.1</version>
                        <executions>
                            <execution>
                                <id>enforce-release-hygiene</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireReleaseDeps>
                                            <message>no SNAPSHOT dependencies in a release build</message>
                                        </requireReleaseDeps>
                                        <banDuplicatePomDependencyVersions/>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
